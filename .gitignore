# Obsidian: ignore all per-machine state by default, then whitelist the
# curated config we DO want to ship (plugin enable-lists, icon mappings,
# Templater + daily-notes settings).
.obsidian/*
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json
!.obsidian/daily-notes.json
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/obsidian-icon-folder/
.obsidian/plugins/obsidian-icon-folder/*
!.obsidian/plugins/obsidian-icon-folder/data.json
!.obsidian/plugins/templater-obsidian/
.obsidian/plugins/templater-obsidian/*
!.obsidian/plugins/templater-obsidian/data.json

# OS cruft
.DS_Store
.trash/
Thumbs.db
